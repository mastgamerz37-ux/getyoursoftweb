# GetYourSoft / ANSH AI — Environment Variables Template for Vercel
# Add these variables in your Vercel Project Dashboard under Settings -> Environment Variables

# 1. Resend API Key (for Transactional Product Key Email Delivery)
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="ANSH AI <onboarding@resend.dev>"

# 2. Telegram Bot API (for Instant Payment Alert & Inline Keyboard)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_user_or_chat_id"

# 3. Firebase Project ID
FIREBASE_PROJECT_ID="intelligent-ansh"

# 4. Security & Webhook Passkey
WEBHOOK_SECRET="your_webhook_secret_passkey_here"
ADMIN_PASSKEY="your_admin_passkey_here"

# 5. Product Download URL
DOWNLOAD_URL="https://github.com/anshu-dubey/ansh-ai/releases/latest/download/AnshAI-Setup-v2.5.0.exe"
